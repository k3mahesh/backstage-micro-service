# Copy this file to .env and fill in the values before running docker compose

# Shared JWT secret — MUST be the same across all backends
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
BACKEND_SECRET=change-me-generate-a-real-secret

# GitHub Personal Access Token (for catalog discovery & scaffolder actions)
GITHUB_TOKEN=ghp_your_token_here

# Postgres password for the backstage user
POSTGRES_PASSWORD=backstage
